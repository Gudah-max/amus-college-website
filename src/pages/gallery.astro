---
import { Image } from 'astro:assets'; import BaseLayout from '../layouts/BaseLayout.astro'; import SiteHeader from '../components/SiteHeader.astro'; import SiteFooter from '../components/SiteFooter.astro'; import PageIntro from '../components/PageIntro.astro'; import {galleryItems,galleryCategories} from '../data/gallery';
---
<BaseLayout title="Gallery | Amus College School" description="Authentic photography of campus life, learning, sport and student participation at Amus College School." canonical="/gallery"><SiteHeader/><main id="main-content"><PageIntro label="Gallery" title="School life, in view." intro="A selection of moments from learning, participation, sport and life around the Amus campus."/><section class="gallery section"><div class="wrap"><div class="gallery-filters" aria-label="Gallery filters">{galleryCategories.map((category,index)=><button type="button" data-filter={category} aria-pressed={index===0?'true':'false'}>{category}</button>)}</div><div class="gallery-grid">{galleryItems.map(item=><figure data-category={item.category}><Image src={item.image.src} widths={[420,720,1080]} sizes="(max-width: 560px) 100vw, (max-width: 900px) 50vw, 33vw" alt={item.alt} loading="lazy"/><figcaption>{item.category}</figcaption></figure>)}</div></div></section></main><SiteFooter/><script is:inline src="/gallery.js"></script></BaseLayout>
