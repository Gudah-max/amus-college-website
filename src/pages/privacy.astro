---
import BaseLayout from '../layouts/BaseLayout.astro'; import SiteHeader from '../components/SiteHeader.astro'; import SiteFooter from '../components/SiteFooter.astro'; import PageIntro from '../components/PageIntro.astro'; import {site} from '../data/site';
---
<BaseLayout title="Privacy | Amus College School" description="Privacy information for Amus College School website enquiries." canonical="/privacy"><SiteHeader/><main id="main-content"><PageIntro label="Privacy" title="Privacy information." intro="This page explains how information submitted through the Amus College School website is handled."/><article class="policy wrap section"><h2>Information submitted through forms</h2><p>When you send an Admissions or Contact enquiry, the details you provide are used by the school to respond to that enquiry.</p><h2>Services used on this website</h2><p>The site uses Netlify infrastructure for form handling. Google Fonts and the Google Maps embed may load when their relevant page content is used.</p><h2>Questions about privacy</h2><p>For privacy questions, contact <a href={`mailto:${site.email}`}>{site.email}</a>.</p></article></main><SiteFooter/></BaseLayout>
