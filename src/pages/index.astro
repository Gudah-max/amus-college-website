---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Hero from '../components/Hero.astro';
import WhyAmus from '../components/WhyAmus.astro';
import LearningPathways from '../components/LearningPathways.astro';
import AcademicEvidence from '../components/AcademicEvidence.astro';
import BoardingLife from '../components/BoardingLife.astro';
import SportsFeature from '../components/SportsFeature.astro';
import BeyondClassroom from '../components/BeyondClassroom.astro';
import CampusFacilities from '../components/CampusFacilities.astro';
import HeadteacherWelcome from '../components/HeadteacherWelcome.astro';
import AdmissionsCTA from '../components/AdmissionsCTA.astro';
import SiteFooter from '../components/SiteFooter.astro';
---
<BaseLayout title="Amus College School | Learning with purpose" description="Amus College School is a boarding secondary school in Bukedea District, Uganda, offering O-Level/UCE and A-Level/UACE education.">
  <SiteHeader />
  <main id="main-content">
    <Hero />
    <WhyAmus />
    <LearningPathways />
    <AcademicEvidence />
    <BoardingLife />
    <SportsFeature />
    <BeyondClassroom />
    <CampusFacilities />
    <HeadteacherWelcome />
    <AdmissionsCTA />
  </main>
  <SiteFooter />
</BaseLayout>
