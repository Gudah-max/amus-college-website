---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import PageIntro from '../components/PageIntro.astro';
---
<BaseLayout title="Admissions | Amus College School" description="O-Level/UCE and A-Level/UACE boarding-school admissions at Amus College School." canonical="/admissions">
  <SiteHeader />
  <main id="main-content">
    <PageIntro label="Admissions" title="Begin the conversation with Amus." intro="Amus College is a boarding school for both O-Level and A-Level students. Contact Admissions for current intake dates and guidance." />
    <section class="admissions-v2 section"><div class="wrap"><div class="admissions-intro"><h2>Clear routes into school life.</h2><p>Families can enquire, plan a visit or share an application enquiry with the Admissions Office.</p></div><div class="admissions-rules"><article><h3>O-Level / UCE</h3><ul><li>Primary Leaving Examination (PLE) results slip</li><li>Birth certificate</li><li>Introductory letter from previous school</li><li>2 passport-size photographs</li><li>Minimum aggregate of 12 in PLE</li></ul></article><article><h3>A-Level / UACE</h3><p>Current S5 entry requirements and subject combinations are confirmed directly with the Admissions Office.</p><ul><li>UCE results slip</li><li>Transfer letter from previous O-Level school</li><li>2 passport-size photographs</li></ul></article></div></div></section>
    <section class="admissions-notes section"><div class="wrap admissions-notes-grid"><div><h2>Plan the next step.</h2><p>Current fees and payment information are available from the Admissions Office. Ask Admissions about any current scholarship or bursary opportunities.</p></div><ol><li>Enquire with a question or your child&rsquo;s intended entry level.</li><li>Arrange a visit or conversation with the school.</li><li>Share the application details below when you are ready.</li></ol></div></section>
    <section id="enquire" class="form-section section"><div class="wrap form-layout"><div><h2>Admissions enquiry</h2><p>By submitting this form, you are asking Amus College School to contact you about your enquiry.</p></div><form name="admissions" method="POST" data-netlify="true" action="/thank-you" class="v2-form"><input type="hidden" name="form-name" value="admissions" /><fieldset><legend>Student information</legend><label>Full Name of Student <b>*</b><input type="text" name="student-name" required autocomplete="name" /></label><label>Date of Birth <b>*</b><input type="date" name="date-of-birth" required /></label><label>Gender <b>*</b><select name="gender" required><option value="">Select gender</option><option>Male</option><option>Female</option></select></label><label>Applying for Level <b>*</b><select name="level" required><option value="">Select level</option><option>O-Level S1 &ndash; S4</option><option>A-Level S5 &ndash; S6</option></select></label><label class="wide">Previous School<input type="text" name="previous-school" /></label></fieldset><fieldset><legend>Parent / Guardian information</legend><label>Parent/Guardian Name <b>*</b><input type="text" name="parent-name" required autocomplete="name" /></label><label>Relationship to Student <b>*</b><select name="relationship" required><option value="">Select relationship</option><option>Father</option><option>Mother</option><option>Guardian</option><option>Other</option></select></label><label>Phone Number <b>*</b><input type="tel" name="phone" required autocomplete="tel" /></label><label>Email Address<input type="email" name="email" autocomplete="email" /></label><label class="wide">Additional Information / Questions<textarea name="additional-info"></textarea></label></fieldset><button class="button button-red" type="submit">Send admissions enquiry</button></form></div></section>
  </main>
  <SiteFooter />
</BaseLayout>
