---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import PageIntro from '../components/PageIntro.astro';
import ContextualCTA from '../components/ContextualCTA.astro';
import { media } from '../data/media';
import { schoolIdentity } from '../data/internal-pages';
import campusAerialView from '../../images/campus_aerial_view.webp';
import studentsSmiling from '../../images/students_smiling_in_school.webp';
---
<BaseLayout title="Our School | Amus College School" description="Discover Amus College School, its boarding-school community, mission, values and campus in Bukedea District, Uganda." canonical="/our-school">
  <SiteHeader />
  <main id="main-content">
    <PageIntro label="Our School" title="A school community with purpose." intro="In Bukedea, Amus College School brings O-Level and A-Level learning, student life and sport together in a boarding-school community." />
    <section class="internal-lead section"><div class="wrap internal-lead-grid"><figure><Image src={media.schoolLead.src} widths={[640, 960, 1400]} sizes="(max-width: 820px) 100vw, 62vw" alt={media.schoolLead.alt} loading="eager" fetchpriority="high" /></figure><div><h2>A school community in Bukedea.</h2><p>{schoolIdentity.overview}</p><p>Academics, student life and sport each form part of a shared school experience.</p></div></div></section>
    <section class="identity-section section"><div class="wrap identity-grid"><div><p class="section-kicker">Purpose and direction</p><h2>Rooted in whole-person development.</h2></div><div class="identity-statements"><article><h3>Vision</h3><p>{schoolIdentity.vision}</p></article><article><h3>Mission</h3><p>{schoolIdentity.mission}</p></article></div></div></section>
    <section class="values-section section"><div class="wrap"><div class="values-heading"><h2>What we stand for.</h2><p>These values provide a shared direction for life and learning at Amus.</p></div><ol class="values-list">{schoolIdentity.values.map(([name, copy]) => <li><h3>{name}</h3><p>{copy}</p></li>)}</ol></div></section>
    <section class="leader-feature section"><div class="wrap leader-feature-grid"><figure><Image src={media.headteacher.src} widths={[480, 720, 900]} sizes="(max-width: 820px) 100vw, 42vw" alt={media.headteacher.alt} loading="lazy" /><figcaption>Richard Olupot <span>Headteacher</span></figcaption></figure><div><h2>A welcome message from our Headteacher</h2><p>A warm welcome to Amus College School. At Amus, we are committed to nurturing students who are academically strong, morally grounded and prepared to make a meaningful contribution to society. We believe education should develop the whole person through disciplined learning, dedicated teaching and a vibrant school community.</p></div></div></section>
    <section class="campus-editorial section"><div class="wrap campus-editorial-grid"><div><h2>A shared environment for learning.</h2><p>Across the school environment, students learn, meet and participate in the everyday life of the Amus community.</p></div><figure><Image src={campusAerialView} widths={[640, 840]} sizes="(max-width: 820px) 100vw, 66vw" alt="Aerial view of an Amus College School building and sports field in Bukedea" loading="lazy" /></figure><figure class="campus-editorial-small"><Image src={studentsSmiling} widths={[400, 720, 1080]} sizes="(max-width: 820px) 100vw, 30vw" alt="Amus students together outside a school building" loading="lazy" /></figure></div></section>
    <ContextualCTA title="Plan a conversation with Amus." copy="Find out more about school life, learning and the experience of boarding at Amus College School." primaryLabel="Contact Amus" primaryHref="/contact" secondaryLabel="Explore learning" secondaryHref="/learning" />
  </main>
  <SiteFooter />
</BaseLayout>
