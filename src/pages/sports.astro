---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import PageIntro from '../components/PageIntro.astro';
import ContextualCTA from '../components/ContextualCTA.astro';
import { media } from '../data/media';
import { athleteProgression, recentSportsHonours } from '../data/sports-records';
---
<BaseLayout title="Sports | Amus College School" description="Explore sport, participation and sports facilities at Amus College School in Bukedea District, Uganda." canonical="/sports">
  <SiteHeader />
  <main id="main-content">
    <PageIntro label="Sports" title="Practice, participation and team spirit." intro="Sport at Amus is part of a fuller school experience, bringing together discipline, teamwork and the energy of participation." />
    <section class="sports-lead-v2 section"><div class="wrap sports-lead-grid"><figure><Image src={media.sportsLeadUganda.src} widths={[720, 1100, 1500]} sizes="(max-width: 820px) 100vw, 62vw" alt={media.sportsLeadUganda.alt} loading="eager" fetchpriority="high" /></figure><div><h2>Sport has its place in a balanced education.</h2><p>Through practice and shared effort, students encounter the habits that sport can build: discipline, teamwork, resilience and respect for one another.</p></div></div></section>
    <section class="sports-football section" id="football"><div class="wrap sports-football-grid"><div><h2>Football, played with purpose.</h2><p>On the pitch, training and participation give students opportunities to work together, build confidence and put disciplined practice into action.</p></div><figure><Image src={media.sportsFootballTurf.src} widths={[640, 960, 1300]} sizes="(max-width: 820px) 100vw, 52vw" alt={media.sportsFootballTurf.alt} loading="lazy" /></figure></div></section>
    <section class="sports-participation section"><div class="wrap"><div class="sports-participation-heading"><h2>Many ways to take part.</h2><p>Participation extends across different activities, with room for students to practise, contribute and support one another.</p></div><div class="sports-participation-images"><figure><Image src={media.sportsVolleyball.src} widths={[520, 800, 1100]} sizes="(max-width: 820px) 100vw, 45vw" alt={media.sportsVolleyball.alt} loading="lazy" /></figure><figure><Image src={media.sportsAthletics.src} widths={[480, 720, 960]} sizes="(max-width: 820px) 100vw, 36vw" alt={media.sportsAthletics.alt} loading="lazy" /></figure></div></div></section>
    <section class="sports-facilities section" id="facilities"><div class="wrap sports-facilities-grid"><figure><Image src={media.sportsGrounds.src} widths={[640, 960, 1400]} sizes="(max-width: 820px) 100vw, 58vw" alt={media.sportsGrounds.alt} loading="lazy" /></figure><div><h2>Space to train, play and gather.</h2><p>Amus sports grounds create a setting for training, matches and the shared experience of supporting a team.</p><p class="sports-caption">A visible part of campus life, alongside learning and community.</p></div></div></section>
    <section class="sports-honours section" aria-labelledby="recent-honours"><div class="wrap"><div class="sports-honours-heading"><div><p class="section-kicker">Recent honours</p><h2 id="recent-honours">A record of recent achievement.</h2></div><p>These dated records recognise competitive milestones in football while keeping the focus on the teams and the work behind them.</p></div><div class="sports-honours-layout"><figure><Image src={media.kigaliCombinedCelebration.src} widths={[560, 840, 1200]} sizes="(max-width: 820px) 100vw, 38vw" alt={media.kigaliCombinedCelebration.alt} loading="lazy" /></figure><div class="sports-honours-records"><ol class="sports-records">{recentSportsHonours.map((record) => <li><p class="sports-record-year">{record.year}</p><div><p class="sports-record-competition">{record.competition}</p><h3>{record.achievement}</h3><p>{record.context}</p></div></li>)}</ol><figure class="sports-honours-support"><Image src={media.kigaliGirlsBronze.src} widths={[520, 800, 1100]} sizes="(max-width: 820px) 100vw, 62vw" alt={media.kigaliGirlsBronze.alt} loading="lazy" /></figure></div></div></div></section>
    <section class="sports-club-progress section" aria-labelledby="club-progression"><div class="wrap"><p class="section-kicker">Club progression</p><h2 id="club-progression">Amus FC promoted to the FUFA Big League.</h2><p>Separate from the school competition record, Amus FC earned promotion to the 2026/27 FUFA Big League after a 2–1 aggregate playoff victory over MYDA FC.</p></div></section>
    <section class="athlete-progression section" aria-labelledby="next-level"><div class="wrap"><div class="athlete-progression-heading"><p class="section-kicker">Former students</p><h2 id="next-level">From Amus to the next level.</h2><p>Two former students whose subsequent football journeys are documented by their current institutions.</p></div><div class="athlete-progression-list">{athleteProgression.map((athlete) => <article><figure><Image src={media[athlete.imageKey].src} widths={[400, 640, 900]} sizes="(max-width: 820px) 42vw, 28vw" alt={media[athlete.imageKey].alt} loading="lazy" /></figure><div><h3>{athlete.name}</h3><p>{athlete.description}</p></div></article>)}</div></div></section>
    <ContextualCTA title="Learn more about life and learning at Amus." copy="Speak with the school about the balanced experience of boarding, learning and participation." primaryLabel="Contact Amus" primaryHref="/contact" secondaryLabel="Life at Amus" secondaryHref="/life-at-amus" />
  </main>
  <SiteFooter />
</BaseLayout>
