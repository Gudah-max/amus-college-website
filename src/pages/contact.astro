---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import PageIntro from '../components/PageIntro.astro';
import { site } from '../data/site';
---
<BaseLayout title="Contact | Amus College School" description="Official contact, visit and enquiry information for Amus College School in Bukedea." canonical="/contact"><SiteHeader /><main id="main-content"><PageIntro label="Contact" title="Speak with Amus." intro="Call, email or visit the school. Our official contact details and enquiry form are here when you need them." /><section class="contact-v2 section"><div class="wrap contact-grid"><div><h2>Direct contact.</h2><p>{site.address[0]}<br />{site.address[1]}</p><p><a href={`mailto:${site.email}`}>{site.email}</a></p>{site.phones.map(phone => <p><a href={`tel:${phone.replaceAll(' ', '')}`}>{phone}</a></p>)}<h3>Office hours</h3><p>Monday&ndash;Saturday: 8:00 AM &ndash; 5:00 PM<br />Sunday &amp; public holidays: 9:00 AM &ndash; 2:00 PM</p><p><a href="https://maps.app.goo.gl/CyqyEhna65zL7LnA8" target="_blank" rel="noopener">Open directions in Google Maps &rarr;</a></p></div><div class="map-wrap"><iframe title="Map showing Amus College School in Uganda" src="https://maps.google.com/maps?q=Amus%20College%20School,%20Uganda&t=&z=14&ie=UTF8&iwloc=&output=embed" loading="lazy"></iframe><p>Map unavailable? Use the address above or <a href="https://maps.app.goo.gl/CyqyEhna65zL7LnA8" target="_blank" rel="noopener">open directions</a>.</p></div></div></section><section class="form-section section"><div class="wrap form-layout"><div><h2>Send a message.</h2><p>Choose a subject and tell us how we can help. By submitting this form, you are asking Amus College School to contact you about your enquiry.</p></div><form name="contact" method="POST" data-netlify="true" action="/thank-you" class="v2-form"><input type="hidden" name="form-name" value="contact" /><fieldset><legend>Your details</legend><label>First Name <b>*</b><input type="text" name="first-name" required autocomplete="given-name" /></label><label>Last Name <b>*</b><input type="text" name="last-name" required autocomplete="family-name" /></label><label>Email Address <b>*</b><input type="email" name="email" required autocomplete="email" /></label><label>Phone Number<input type="tel" name="phone" autocomplete="tel" /></label><label class="wide">Subject <b>*</b><select name="subject" required><option value="">Select a subject</option><option>Admissions Enquiry</option><option>Academic Information</option><option>School Fees Enquiry</option><option>Co-curricular Activities</option><option>Campus Visit Request</option><option>Partnership / Collaboration</option><option>General Enquiry</option></select></label><label class="wide">Your Message <b>*</b><textarea name="message" required></textarea></label></fieldset><button class="button button-red" type="submit">Send Message</button></form></div></section></main><SiteFooter /></BaseLayout>
