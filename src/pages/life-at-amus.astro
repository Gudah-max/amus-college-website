---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import PageIntro from '../components/PageIntro.astro';
import ContextualCTA from '../components/ContextualCTA.astro';
import { media } from '../data/media';
import scoutOne from '../../images/scout_1.webp';
---
<BaseLayout title="Life at Amus | Amus College School" description="Explore boarding school life, activities and community at Amus College School in Bukedea District, Uganda." canonical="/life-at-amus">
  <SiteHeader />
  <main id="main-content">
    <PageIntro label="Life at Amus" title="A shared life beyond the classroom." intro="Life at Amus is shaped by the shared moments, relationships and activities that extend learning beyond the classroom." />
    <section class="life-boarding section" id="boarding"><div class="wrap life-boarding-grid"><div><h2>Living and learning, together.</h2><p>At Amus, boarding brings students into a shared school day beyond lesson time.</p><p>Study, meals, activities and time with peers form part of the residential school experience.</p></div><figure><Image src={media.boarding.src} widths={[640, 960, 1384]} sizes="(max-width: 820px) 100vw, 58vw" alt={media.boarding.alt} loading="eager" fetchpriority="high" /></figure></div></section>
    <section class="life-rhythm section"><div class="wrap life-rhythm-grid"><figure><Image src={media.communityGathering.src} widths={[480, 760, 1080]} sizes="(max-width: 820px) 100vw, 42vw" alt="Students gathered together at Amus College School" loading="lazy" /></figure><div><h2>A community made in shared moments.</h2><p>Students gather, learn and spend time together as part of the wider school community.</p><p class="life-caption">Shared experiences that continue beyond formal lessons.</p></div></div></section>
    <section class="life-faith section"><div class="wrap life-faith-grid"><div><h2>Faith, reflection and community.</h2><p>School-community gatherings create space for reflection, music and shared participation as part of life at Amus.</p><p class="life-caption"><strong>Upcoming:</strong> Amus College Chapel Choir is scheduled to represent the school at an International Hymn Festival in Nakuru in late October 2026.</p></div><figure><Image src={media.lifePrayer.src} widths={[560, 900, 1200]} sizes="(max-width: 820px) 100vw, 55vw" alt={media.lifePrayer.alt} loading="lazy" /></figure></div></section>
    <section class="life-creative section" id="activities"><div class="wrap"><div class="life-creative-heading"><h2>Creative life and participation.</h2><p>Music, dance and drama give students ways to express ideas, contribute and take part alongside their learning.</p></div><figure class="life-creative-image"><Image src={media.beyond.src} widths={[720, 1100, 1500]} sizes="100vw" alt={media.beyond.alt} loading="lazy" /></figure></div></section>
    <section class="life-participation section"><div class="wrap life-participation-grid"><div><h2>Practical participation and teamwork.</h2><p>Students also take part in debate, scouting and other activities that encourage communication, teamwork and confidence.</p></div><div class="life-participation-images life-participation-images--single"><figure><Image src={scoutOne} widths={[420, 680, 960, 1280]} sizes="(max-width: 820px) 100vw, 44vw" alt="Students taking part in scouting activities at Amus College School" loading="lazy" /></figure></div></div></section>
    <ContextualCTA title="See what life at Amus can feel like." copy="Talk with the school about boarding life, learning and the next step for your family." primaryLabel="Contact Amus" primaryHref="/contact" secondaryLabel="Explore learning" secondaryHref="/learning" />
  </main>
  <SiteFooter />
</BaseLayout>
