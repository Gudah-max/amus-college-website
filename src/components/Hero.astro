---
import { Image } from 'astro:assets';
import { media } from '../data/media';
---
<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="hero-image">
    <Image src={media.hero.src} widths={[640, 960, 1280, 1600]} sizes="(max-width: 820px) 100vw, 62vw" format="webp" quality={78} loading="eager" fetchpriority="high" alt={media.hero.alt} />
  </div>
  <div class="hero-panel">
    <div class="hero-panel-inner">
      <p class="hero-kicker">Amus College School · Bukedea, Uganda</p>
      <h1 id="hero-title">Learning with purpose.<br />Growing with character.</h1>
      <p>Amus College School is a boarding school offering O-Level/UCE and A-Level/UACE education.</p>
      <div class="hero-actions"><a class="button button-red" href="/admissions">Enquire about admission</a><a class="text-link light-link" href="/learning">Explore learning <span>&rarr;</span></a></div>
    </div>
  </div>
</section>
