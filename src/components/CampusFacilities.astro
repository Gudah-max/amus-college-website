---
import { Image } from 'astro:assets';
import { media } from '../data/media';
---
<section class="campus section"><div class="wrap campus-layout">
  <div><h2>A place to settle into learning.</h2><p>Campus life brings together teaching spaces, study time, sport and the shared rhythms of a boarding school.</p></div>
  <figure class="campus-main"><Image src={media.campusOne.src} widths={[640, 960, 1400]} sizes="(max-width: 820px) 100vw, 67vw" alt={media.campusOne.alt} loading="lazy" /><figcaption>Amus College School, Bukedea District, Uganda.</figcaption></figure>
  <figure class="campus-small first"><Image src={media.campusTwo.src} widths={[360, 680, 1000]} sizes="(max-width: 560px) 100vw, 33vw" alt={media.campusTwo.alt} loading="lazy" /></figure>
  <figure class="campus-small second"><Image src={media.facility.src} widths={[360, 620, 900]} sizes="(max-width: 560px) 100vw, 33vw" alt={media.facility.alt} loading="lazy" /></figure>
</div></section>
