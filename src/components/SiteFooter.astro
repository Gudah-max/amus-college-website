---
import { Image } from 'astro:assets';
import { primaryNavigation } from '../data/navigation';
import { media } from '../data/media';
import { site } from '../data/site';
import SocialIcon from './icons/SocialIcon.astro';

const socialLinks = [
  { platform: 'facebook', label: 'Facebook', href: site.social.facebook },
  { platform: 'x', label: 'X', href: site.social.x },
  { platform: 'youtube', label: 'YouTube', href: site.social.youtube },
  { platform: 'tiktok', label: 'TikTok', href: site.social.tiktok },
  { platform: 'instagram', label: 'Instagram', href: site.social.instagram },
] as const;
---
<footer id="contact">
  <div class="wrap footer-grid">
    <div>
      <a class="brand footer-brand" href="/">
        <Image src={media.crest.src} width={56} height={56} alt="" />
        <span>AMUS <small>COLLEGE SCHOOL</small></span>
      </a>
      <p>Learning with purpose. Growing with character.</p>
      <nav class="footer-social" aria-label="Follow Amus College School">
        {socialLinks.map(({ platform, label, href }) => (
          <a href={href} target="_blank" rel="noopener noreferrer" aria-label={`Amus College School on ${label}`}>
            <SocialIcon platform={platform} />
          </a>
        ))}
      </nav>
    </div>
    <div>
      <h2>Visit or enquire</h2>
      <p>{site.address[0]}<br />{site.address[1]}</p>
      <a href={`mailto:${site.email}`}>{site.email}</a>
      {site.phones.map((phone) => <a href={`tel:${phone.replaceAll(' ', '')}`}>{phone}</a>)}
    </div>
    <div>
      <h2>Explore</h2>
      {primaryNavigation.map((item) => <a href={item.href}>{item.label}</a>)}
      <a href="/gallery">Gallery</a><a href="/contact">Contact</a><a href="/privacy">Privacy</a><a href="/cookies">Cookies</a>
    </div>
  </div>
  <div class="wrap footer-bottom"><span>&copy; Amus College School</span><a href="#top">Back to top &uarr;</a></div>
</footer>
